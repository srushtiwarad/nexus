# ============================================================
# nexus/backend/.env.example  —  Copy to .env and fill in
# ============================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ── Database (MySQL / XAMPP) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexus_db
DB_USER=root
DB_PASSWORD=
# DB_PASSWORD=your_xampp_mysql_password  (blank by default in XAMPP)

# ── JWT (generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_64_byte_hex_access_secret
JWT_REFRESH_SECRET=replace_with_64_byte_hex_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SEC=604800

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Email (Gmail SMTP recommended for dev) ────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=your_gmail@gmail.com

# ── App URL (for email links) ─────────────────────────────────
APP_URL=http://localhost:5173
